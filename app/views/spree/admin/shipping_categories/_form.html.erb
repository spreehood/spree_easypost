<div class="card mb-4">
  <div class="card-body">
    <div class="form-group">
      <%= f.label :name, Spree.t(:name) %>
      <%= f.text_field :name, class: 'form-control', autofocus: f.object.new_record?, required: true %>
      <%= f.error_message_on :name %>
    </div>
    <div class="form-group">
      <div class="form-check">
        <%= f.check_box :use_easypost, class: 'form-check-input cursor-pointer' %>
        <%= f.label :use_easypost, Spree.t(:use_easypost), class: 'form-check-label' %>
      </div>
    </div>
  </div>
</div>
